#!/bin/bash
# Manage eSIM profiles on a removable eSIM card (9eSIM, 5ber, ...) in the X12's SIM tray,
# through the Fibocom L850-GL modem and lpac's AT driver.
# Needs lpac with patches/lpac-xmm7360-le.patch (docs/07-lte-modem-gps.md).
#
#   x12-esim info                                   EID and free memory
#   x12-esim list                                   installed profiles
#   x12-esim download 'LPA:1$<smdp>$<matching-id>' [confirmation-code]
#   x12-esim enable|disable|delete <iccid>
#   x12-esim nickname <iccid> <name>
#   x12-esim help                                   this text
#
# ModemManager is stopped for the run (lpac and ModemManager must not share the AT port).
# If it is still bringing the modem up (e.g. just after boot), the script first waits for that.
# Afterwards it is started again. Its second setup of the modem crashes the modem firmware, and
# iosm-x12 then resets the modem (kernel-fixes-x12), so mobile data is back after about a minute.
# No other AT commands are sent to the modem. lpac waits forever for a modem that does not answer,
# so each run has a time limit.
set -u

usage() { sed -n '6,11p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-2}"; }
case ${1:-} in help|-h|--help) usage 0 ;; esac

[ "$EUID" = 0 ] || exec sudo "$0" "$@"

PORT=${X12_ESIM_PORT:-/dev/wwan0at1}
export LPAC_APDU=at LPAC_APDU_AT_DEVICE=$PORT

die() { echo "x12-esim: $*" >&2; exit 1; }

[ $# -ge 1 ] || usage
cmd=$1; shift
case $cmd in
    info|list) [ $# = 0 ] || usage ;;
    download) [ $# = 1 ] || [ $# = 2 ] || usage ;;
    enable|disable|delete) [ $# = 1 ] || usage ;;
    nickname) [ $# = 2 ] || usage ;;
    *) usage ;;
esac

command -v lpac >/dev/null || die "lpac is not installed"
[ -c "$PORT" ] || die "$PORT not found (is the modem up? see 'ls /dev/wwan*')"
# The patched lpac lists the WWAN AT ports; stock lpac does not and cannot talk to this modem.
lpac driver apdu list 2>/dev/null | grep -q "\"$PORT\"" ||
    die "this lpac lacks patches/lpac-xmm7360-le.patch (it does not list $PORT)"

if systemctl -q is-active ModemManager; then
    # Stopping ModemManager while it is still probing or enabling the modem leaves the modem
    # unanswering. Wait (up to 2 min) until it reports a settled state.
    for i in $(seq 60); do
        state=$(mmcli -m any 2>/dev/null | sed -e 's/\x1b\[[0-9;]*m//g' -n -e 's/^ *| *state: *//p' | head -1)
        case $state in
            disabled|enabled|searching|registered|connected|locked|failed) break ;;
        esac
        [ "$i" = 1 ] && echo "waiting for ModemManager to finish bringing the modem up..."
        sleep 2
    done
    systemctl stop ModemManager || die "could not stop ModemManager"
    sleep 3
    trap 'systemctl start ModemManager &&
          echo "x12-esim: ModemManager started again; the modem resets itself, mobile data is back in about a minute"' EXIT
fi

case $cmd in
    download) limit=300 ;;
    *)        limit=60 ;;
esac

# Print lpac's JSON lines in readable form; exit status 1 if the last result was not code 0.
show() {
    python3 -I -c '
import json, sys
ok = False
for line in sys.stdin:
    try:
        msg = json.loads(line)
    except ValueError:
        print(line.rstrip())
        continue
    p = msg.get("payload", {})
    if msg.get("type") == "progress":
        print("  ..", p.get("message"))
        continue
    ok = p.get("code") == 0
    d = p.get("data")
    if not ok:
        print("FAILED:", p.get("message"), "-", d if d else "")
    elif isinstance(d, list):
        if not d:
            print("no profiles")
        for x in d:
            print("%-22s %-9s %-24s %s" % (x.get("iccid"), x.get("profileState"),
                  x.get("serviceProviderName") or "", x.get("profileNickname") or ""))
    elif isinstance(d, dict) and "eidValue" in d:
        res = (d.get("EUICCInfo2") or {}).get("extCardResource") or {}
        print("EID:        ", d["eidValue"])
        print("free memory:", res.get("freeNonVolatileMemory"), "bytes")
    else:
        print("OK", json.dumps(d) if d else "")
sys.exit(0 if ok else 1)
'
}

run() { timeout "$limit" lpac "$@"; }
case $cmd in
    info)     run chip info ;;
    list)     run profile list ;;
    download) if [ $# = 2 ]; then run profile download -a "$1" -c "$2"; else run profile download -a "$1"; fi ;;
    enable)   run profile enable "$1" ;;
    disable)  run profile disable "$1" ;;
    delete)   run profile delete "$1" ;;
    nickname) run profile nickname "$1" "$2" ;;
esac 2>&1 | show
status=(${PIPESTATUS[@]})

if [ "${status[0]}" = 124 ]; then
    echo "x12-esim: the modem did not answer within $limit s; lpac was stopped" >&2
    echo "x12-esim: if this repeats, check 'journalctl -k | grep iosm' and reboot before trying again" >&2
    exit 1
fi
exit "${status[1]}"
