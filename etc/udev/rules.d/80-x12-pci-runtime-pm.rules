# ThinkPad X12: let PCI devices runtime-suspend when idle (the default leaves about a dozen
# chipset devices always on). Measured at settled idle: about 0.1-0.15 W less.
ACTION=="add|bind", SUBSYSTEM=="pci", ATTR{power/control}="auto"
# Needs iosm-x12 (dkms/): with the stock iosm driver, the LTE modem on "auto" hangs
# hibernation with a garbled screen. Without iosm-x12, keep the modem on "on":
#ACTION=="add|bind", SUBSYSTEM=="pci", ATTR{vendor}=="0x8086", ATTR{device}=="0x7360", ATTR{power/control}="on"
